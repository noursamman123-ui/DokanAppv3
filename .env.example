# Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit the real .env file to version control.

# WooCommerce Base URL (no trailing slash)
API_BASE_URL=https://staging.dokan.com.sy

# AppName
APP_NAME=Dokan

# Bundle IDs
ANDROID_PACKAGE_NAME=com.dokan.app
IOS_BUNDLE_ID=com.dokan.app

# OneSignal (for push notifications – Phase 2)
# ONESIGNAL_APP_ID=

# Firebase (for analytics and crash reporting – Phase 2)
# FIREBASE_API_KEY=
